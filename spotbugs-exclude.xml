<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- The injected repository is an intentionally shared storage port.
       Copying it would defeat constructor injection and database identity. -->
  <Match>
    <Class name="de.appfabrik.buecherregal.application.BookService"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!-- The transfer service shares the same repository and file ports by constructor injection. -->
  <Match>
    <Class name="de.appfabrik.buecherregal.application.CollectionTransfer"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
